# Guard self-hosted settings (docs/self-host.md). Copy this file OUTSIDE the repository, fill it in,
# `chmod 600` it and pass it with `--env-file`. Never commit the filled-in copy.

# The address people and laptops use. https:// behind your TLS reverse proxy.
# Plain http is accepted only for http://localhost or http://127.0.0.1 trials.
REGISTRY_BASE_URL=https://guard.example.com

# Postgres password for the bundled database. Generate one: openssl rand -hex 24
GUARD_DB_PASSWORD=

# Sign-in. Choose ONE provider.
#
# Your own OpenID Connect provider (Okta, Entra ID, Keycloak, Authentik, dex, ...):
#   redirect URI to register: <REGISTRY_BASE_URL>/api/auth/callback/oidc
#   REGISTRY_OIDC_ISSUER must equal the "issuer" in <issuer>/.well-known/openid-configuration.
#   The provider must return a verified email (email_verified: true).
REGISTRY_OIDC_PROVIDER=oidc
REGISTRY_OIDC_ISSUER=https://login.example.com
REGISTRY_OIDC_NAME=Example SSO
#
# Or Google: set REGISTRY_OIDC_PROVIDER=google, leave REGISTRY_OIDC_ISSUER empty and register
#   <REGISTRY_BASE_URL>/api/auth/callback/google in your Google OAuth client.
REGISTRY_OIDC_CLIENT_ID=
REGISTRY_OIDC_CLIENT_SECRET=

# Who may create an organisation on this server. Keep allowlist: only your own domain (and addresses or
# domains you list later under Sign-ups) can create one. Personal mailboxes (gmail.com and similar)
# never create an organisation, except the one address in REGISTRY_OWNER_EMAIL.
REGISTRY_REGISTRATION=allowlist
REGISTRY_OPERATOR_DOMAIN=example.com
REGISTRY_CONTACT_EMAIL=it@example.com
#
# Optional: the one person who owns this server's organisation when they sign in with a personal
# mailbox, for example a Google account on gmail.com. Leave empty when everyone uses your domain.
REGISTRY_OWNER_EMAIL=

# Trial servers only: 1 makes an organisation that has not saved its Guard settings or rules open in Enforce
# with the starter rules, so a pasted test card number is blocked. Enforce also blocks connections Guard cannot
# inspect. Leave empty on a server your company uses: a new organisation then opens in Monitor.
GUARD_QUICK_START=

# Where Guard listens on this host. Keep 127.0.0.1 unless the proxy runs on another machine.
GUARD_BIND_ADDRESS=127.0.0.1
GUARD_PORT=4700
