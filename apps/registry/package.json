{
  "name": "@vibtra/registry",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Vibtra registry \u2014 the PUBLIC append-only ledger service (A3 carve-out). Import direction law: the private envelope (@vibtra/backend) MAY import this package; this package MUST NEVER import @vibtra/backend \u2014 the fresh-history split (SPLIT.md) cuts along exactly that edge.",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm --filter @vibtra/guard-console build",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "reseal": "tsx src/main.ts reseal",
    "plan": "tsx src/main.ts plan",
    "plan-requests": "tsx src/main.ts plan-requests",
    "rotate-issuer-key": "tsx src/main.ts rotate-issuer-key"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/sso": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "@fastify/compress": "^9.2.0",
    "@fastify/static": "^8.0.0",
    "@vibtra/console-api": "workspace:*",
    "@vibtra/guard-contract": "workspace:*",
    "@vibtra/ui": "workspace:*",
    "better-auth": "^1.7.2",
    "fastify": "^5.0.0",
    "pg": "^8.23.0",
    "stripe": "22.6.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
