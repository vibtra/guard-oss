new file mode 100644
index 0000000..a8edd23
--- /dev/null
+++ b/packages/ledger/src/discount.ts
@@ -0,0 +1,11 @@
+export type Tier = 'basic' | 'team' | 'enterprise';
+
+const RATES: Record<Tier, number> = { basic: 0, team: 0.1, enterprise: 0.25 };
+
+export const discountCents = (tier: Tier, subtotalCents: number, couponCents = 0): number => {
+  if (!Number.isInteger(subtotalCents) || subtotalCents < 0) {
+    throw new Error('subtotal must be a whole number of cents');
+  }
+  const byTier = Math.floor(subtotalCents * RATES[tier]);
+  return Math.min(byTier + couponCents, subtotalCents);
+};
