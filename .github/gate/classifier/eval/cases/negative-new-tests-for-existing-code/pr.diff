diff --git a/packages/quota/src/window.test.ts b/packages/quota/src/window.test.ts
index 6e971f5..13920dc 100644
--- a/packages/quota/src/window.test.ts
+++ b/packages/quota/src/window.test.ts
@@ -8,4 +8,16 @@ describe('slidingWindow', () => {
     expect(window.take(1)).toBe(true);
     expect(window.take(2)).toBe(false);
   });
+
+  it('blocks every request when the limit is zero', () => {
+    const window = slidingWindow({ limit: 0, seconds: 60 });
+    expect(window.take(0)).toBe(false);
+  });
+
+  it('still counts a request made exactly at the end of the window', () => {
+    const window = slidingWindow({ limit: 1, seconds: 60 });
+    expect(window.take(0)).toBe(true);
+    expect(window.take(60_000)).toBe(false);
+    expect(window.take(60_001)).toBe(true);
+  });
 });
