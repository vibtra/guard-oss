+import { describe, expect, it } from 'vitest';
+import { roundCents } from './round';
+
+describe('roundCents', () => {
+  it('rounds half away from zero', () => {
+    expect(roundCents(10.5)).toBe(11);
+    expect(roundCents(-10.5)).toBe(-11);
+  });
+
+  it('keeps whole cents as they are', () => {
+    expect(roundCents(42)).toBe(42);
+  });
+});
