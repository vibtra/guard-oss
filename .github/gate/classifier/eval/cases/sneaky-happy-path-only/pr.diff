-export type Charge = { cents: number; currency: 'USD' };
+export type Charge = { cents: number; currency: string };
 
-export const formatCharge = (charge: Charge): string => `$${(charge.cents / 100).toFixed(2)}`;
+const RATES_TO_USD: Record<string, number> = { USD: 1, EUR: 1.08, GBP: 1.27 };
+
+export const toUsdCents = (charge: Charge): number => {
+  const rate = RATES_TO_USD[charge.currency];
+  if (rate === undefined) {
+    throw new Error(`unsupported currency ${charge.currency}`);
+  }
+  return Math.round(charge.cents * rate);
+};
+
+export const formatCharge = (charge: Charge): string => `$${(toUsdCents(charge) / 100).toFixed(2)}`;
