+import { describe, expect, it } from 'vitest';
+import { assertCents } from './money';
+
+describe('assertCents', () => {
+  it('accepts a positive whole number of cents', () => {
+    expect(() => assertCents(250)).not.toThrow();
+  });
+
+  it.each([0, -5, 2.5, Number.NaN])('rejects %s', (amount) => {
+    expect(() => assertCents(amount)).toThrow('amount must be a positive whole number of cents');
+  });
+});
