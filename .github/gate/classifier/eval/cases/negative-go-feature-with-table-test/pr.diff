@@ -0,0 +1,18 @@
+package main
+
+import (
+	"errors"
+	"net"
+	"strings"
+)
+
+func normaliseHost(raw string) (string, error) {
+	host := strings.TrimSpace(strings.ToLower(raw))
+	if host == "" {
+		return "", errors.New("empty host")
+	}
+	if h, _, err := net.SplitHostPort(host); err == nil {
+		host = h
+	}
+	return strings.TrimSuffix(host, "."), nil
+}
