@@ -0,0 +1,28 @@
+package main
+
+import "testing"
+
+func TestNormaliseHost(t *testing.T) {
+	cases := []struct {
+		raw     string
+		want    string
+		wantErr bool
+	}{
+		{raw: "API.Example.Test", want: "api.example.test"},
+		{raw: "api.example.test:8443", want: "api.example.test"},
+		{raw: "api.example.test.", want: "api.example.test"},
+		{raw: "   ", wantErr: true},
+	}
+	for _, c := range cases {
+		got, err := normaliseHost(c.raw)
+		if c.wantErr {
+			if err == nil {
+				t.Fatalf("normaliseHost(%q): want an error", c.raw)
+			}
+			continue
+		}
+		if err != nil || got != c.want {
+			t.Fatalf("normaliseHost(%q) = %q, %v; want %q", c.raw, got, err, c.want)
+		}
+	}
+}
