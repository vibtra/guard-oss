  "context": {
    "$comment": "requireContext on au-tfn / au-acn: a checksum-valid 3-3-3 number counts only with a context word within 60 characters (also as an identifier: tax_file_number, taxFileNo) — and when it is written in the issuer's spaced grouping (`123 456 782` for the TFN, ASIC's `000 000 019` for the ACN). An unspaced or dashed run with no context word stays quiet: AI-service telemetry carries nine-digit IDs (a context-free ACN rule blocked a logged-out meta.ai POST /api/analytics). Without requireContext every text here fires (Presidio parity).",
    "tfn": { "fire": ["TFN 100 200 300", "my tax file number is 123 456 782", "TFN: 876-543-210", "tax_file_number: 123456782", "taxFileNo=876543210", "Jane Citizen, 123 456 782, Level 2 payroll"], "quiet": ["ref 100200300", "she scored 876543210 points", "ref 100-200-300"] },
    "acn": { "fire": ["ACN 004 085 616", "company number: 010 499 966", "acn=010499966", "Fernwood Holdings Pty Ltd, 004 085 616, registered in NSW"], "quiet": ["ref 004085616", "ref 004-085-616", "order 010499966 shipped", "{\"event\":\"view\",\"sid\":\"010499966\",\"ts\":1760650000}"] }
  },
